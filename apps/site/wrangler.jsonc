// Cloudflare Pages config for the static site: the `nuxt generate` output is
// uploaded as-is by `wrangler pages deploy` from `.github/workflows/site.yml`
// on every push to `main`. The Pages project (`name`) and its custom domain
// are set up in the Cloudflare dashboard; Pages serves `404.html` with a 404
// status and handles trailing slashes on its own.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visual-regression",
  "compatibility_date": "2026-10-01",
  "pages_build_output_dir": ".output/public",
}
